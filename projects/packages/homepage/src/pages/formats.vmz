<template>
  <div class="zb-formats-page">
    <header class="zb-site-header">
      <Link class="zb-site-header__brand" href="/"><strong>zip-bomber</strong></Link>
      <nav class="zb-site-header__nav" aria-label="Primary">
        <Link href="/">Home</Link>
        <Link href="/formats">Variants</Link>
      </nav>
    </header>
    <main>
      <h1>@sxo/zip-bomber probe</h1>
      <p class="zb-formats-page__lede">
        Live probe through `@sxo/zip-bomber` only. WASM in the browser, Node bindings in CI and local verify.
      </p>

      <Card title="Probe results" description="Live binding capabilities.">
        <dl class="zb-formats-page__probe">
          <div><dt>backend</dt><dd>{{ zbBackend }}</dd></div>
          <div><dt>listVariants()</dt><dd>{{ zbVariants }}</dd></div>
        </dl>
      </Card>

      <Card title="Node self-test" description="CI / local verify without a browser.">
        <CodeBlock
          :code="selfTestSample"
          caption="shell"
          copy-label="Copy"
          @copy="() => this.copySelfTest()"
        />
      </Card>
    </main>
  </div>
</template>

<style>
  .zb-site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--vmz-line-default, #e2e8f0);
  }
  .zb-site-header__brand {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--vmz-text-ink, #0f172a);
  }
  .zb-site-header__nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .zb-formats-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .zb-formats-page h1 {
    margin: 0;
  }
  .zb-formats-page__lede {
    margin: 0;
    color: var(--vmz-text-steel, #475569);
    line-height: 1.55;
  }
  .zb-formats-page__probe {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .zb-formats-page__probe div {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0.5rem;
    font-family: var(--vmz-font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
  }
  .zb-formats-page__probe dt {
    color: var(--vmz-text-steel, #475569);
  }
  .zb-formats-page__probe dd {
    margin: 0;
  }
</style>

<script client>
import { probeZipBomber } from '../lib/zip-bomber-probe.ts';

export default class FormatsPage {
    selfTestSample = 'pnpm --filter @sxo/homepage test:zip-bomber';
    zbBackend = '';
    zbVariants = '';

    async onMount() {
        const probe = await probeZipBomber();
        this.zbBackend = probe.backend;
        this.zbVariants = probe.variants.join(', ');
    }

    async copySelfTest() {
        const text = String(this.selfTestSample || '');
        if (!text || typeof navigator === 'undefined' || !navigator.clipboard?.writeText) return;
        try {
            await navigator.clipboard.writeText(text);
        } catch {
            /* ignore */
        }
    }
}
</script>
