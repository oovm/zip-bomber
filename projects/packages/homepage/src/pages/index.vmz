<template>
  <div class="zb-home">
    <header class="zb-site-header">
      <Link class="zb-site-header__brand" href="/"><strong>zip-bomber</strong></Link>
      <nav class="zb-site-header__nav" aria-label="Primary">
        <Link href="/">Home</Link>
        <Link href="/formats">Variants</Link>
      </nav>
    </header>
    <main>
      <section class="zb-home__hero" aria-labelledby="zb-hero-title">
        <Badge tone="brand">Recursive ZIP generators</Badge>
        <h1 id="zb-hero-title">Generate bomb, quine, loopy, and fractal ZIPs.</h1>
        <p class="zb-home__lede">
          zip-bomber builds recursive archive variants for robustness testing. Rust crates use the
          <code>zb-*</code> prefix; npm packages stay <code>@sxo/zip-bomber*</code>.
        </p>
        <div class="zb-home__actions">
          <Link href="/formats"><Button type="button" variant="primary">Probe bindings</Button></Link>
        </div>
      </section>

      <section class="zb-home__grid" aria-label="Binding snapshot">
        <Card title="Live probe" description="Browser WASM or host Node bindings via @sxo/zip-bomber.">
          <dl class="zb-home__probe">
            <div><dt>backend</dt><dd>{{ zbBackend }}</dd></div>
            <div><dt>variants</dt><dd>{{ zbVariants }}</dd></div>
          </dl>
        </Card>
        <Card title="Install" description="TypeScript facade over platform packages.">
          <CodeBlock
            :code="installSample"
            caption="shell"
            copy-label="Copy"
            @copy="() => this.copyInstall()"
          />
        </Card>
      </section>
    </main>
  </div>
</template>

<style>
  .zb-site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--vmz-line-default, #e2e8f0);
  }
  .zb-site-header__brand {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--vmz-text-ink, #0f172a);
  }
  .zb-site-header__nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .zb-home {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
  }
  .zb-home__hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.5rem 0 2rem;
  }
  .zb-home__hero h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
  }
  .zb-home__lede {
    margin: 0;
    max-width: 40rem;
    color: var(--vmz-text-steel, #475569);
    line-height: 1.55;
  }
  .zb-home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .zb-home__grid {
    display: grid;
    gap: 1.25rem;
  }
  .zb-home__probe {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .zb-home__probe div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.5rem;
    font-family: var(--vmz-font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
  }
  .zb-home__probe dt {
    color: var(--vmz-text-steel, #475569);
  }
  .zb-home__probe dd {
    margin: 0;
  }
  @media (min-width: 720px) {
    .zb-home__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>

<script client>
import { probeZipBomber } from '../lib/zip-bomber-probe.ts';

export default class IndexPage {
    installSample = 'pnpm add @sxo/zip-bomber';
    zbBackend = '';
    zbVariants = '';

    async onMount() {
        const probe = await probeZipBomber();
        this.zbBackend = probe.backend;
        this.zbVariants = probe.variants.join(', ');
    }

    async copyInstall() {
        const text = String(this.installSample || '');
        if (!text || typeof navigator === 'undefined' || !navigator.clipboard?.writeText) return;
        try {
            await navigator.clipboard.writeText(text);
        } catch {
            /* ignore */
        }
    }
}
</script>
