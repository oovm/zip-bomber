{
    "name": "@sxo/zip-bomber",
    "version": "0.0.0",
    "description": "Generate recursive ZIP / zip-bomb variants (bomb, quine, loopy, fractal)",
    "keywords": [
        "zip",
        "zip-bomb",
        "zip-quine",
        "quine",
        "self-reproducing",
        "recursive-archive",
        "deflate",
        "archive",
        "security-testing",
        "fuzzing",
        "napi",
        "wasm"
    ],
    "license": "MPL-2.0",
    "author": "Aster <192607617@qq.com>",
    "homepage": "https://github.com/oovm/zip-bomber/tree/dev/projects/packages/zip-bomber#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/zip-bomber.git",
        "directory": "projects/packages/zip-bomber"
    },
    "bugs": {
        "url": "https://github.com/oovm/zip-bomber/issues"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./node": "./src/node/index.ts",
        "./wasm": "./src/wasm/index.ts",
        "./cli": "./src/cli/index.ts"
    },
    "bin": {
        "zb": "bin/zip-bomber"
    },
    "engines": {
        "node": ">=20"
    },
    "files": [
        "bin",
        "locales",
        "readme.md",
        "src"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test:e2e": "tsx --test tests/**/*.test.ts"
    },
    "dependencies": {
        "@sxo/zip-bomber-unknown-wasm32": "workspace:*",
        "@vmz/commander": "^0.2.0",
        "jiti": "^2.4.2"
    },
    "optionalDependencies": {
        "@sxo/zip-bomber-darwin-arm64": "workspace:*",
        "@sxo/zip-bomber-darwin-x64": "workspace:*",
        "@sxo/zip-bomber-linux-arm64": "workspace:*",
        "@sxo/zip-bomber-linux-x64": "workspace:*",
        "@sxo/zip-bomber-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
